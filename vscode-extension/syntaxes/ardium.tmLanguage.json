{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Ardium",
  "scopeName": "source.ardium",
  "patterns": [
    { "include": "#comments" },
    { "include": "#attributes" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#coreui" },
    { "include": "#memory_builtins" },
    { "include": "#functions" },
    { "include": "#strings" },
    { "include": "#numbers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.cell.ardium",
          "match": "^\\s*//\\s*%%.*$"
        },
        {
          "name": "comment.line.double-slash.ardium",
          "match": "//.*$"
        },
        {
          "name": "comment.block.ardium",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "attributes": {
      "patterns": [
        {
          "name": "storage.modifier.attribute.ardium",
          "match": "@(owned|State|External|export|extern|inline|simd)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.ardium",
          "match": "\\b(if|elif|else|while|for|in|return|break|continue|match|defer|async|await)\\b"
        },
        {
          "name": "storage.type.ardium",
          "match": "\\b(fn|let|var|struct|enum|impl|import|extern|type|const)\\b"
        },
        {
          "name": "constant.language.boolean.ardium",
          "match": "\\b(true|false|null|nil)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.ardium",
          "match": "\\b(int|i8|i16|i32|i64|u8|u16|u32|u64|usize|float|f32|f64|string|bool|void|ptr|i8_ptr|i32_ptr|i64_ptr|Any)\\b"
        }
      ]
    },
    "coreui": {
      "patterns": [
        {
          "name": "support.class.coreui.ardium",
          "match": "\\b(CoreUI|VStack|HStack|ZStack|Title|Headline|Text|Button|TextField|Spacer|Divider|Canvas|List|Card)\\b"
        }
      ]
    },
    "memory_builtins": {
      "patterns": [
        {
          "name": "support.function.memory.ardium",
          "match": "\\b(alloc|free|peek|poke|print|println|assert)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": { "name": "storage.type.function.ardium" },
            "2": { "name": "entity.name.function.ardium" }
          }
        },
        {
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.call.ardium" }
          }
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.ardium",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.ardium",
          "match": "\\\\."
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.ardium",
          "match": "\\b0x[0-9a-fA-F_]+\\b"
        },
        {
          "name": "constant.numeric.float.ardium",
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*\\b"
        },
        {
          "name": "constant.numeric.integer.ardium",
          "match": "\\b[0-9][0-9_]*\\b"
        }
      ]
    }
  }
}
