<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Secrets.plist.example — MicroCode Open Source
  
  Copy this file to "Secrets.plist" and fill in your own keys.
  Secrets.plist is gitignored and will never be committed.
  
  MicroCode uses a self-hosted Supabase instance for all account sessions,
  entitlement data, and quota. Never put a service-role key in this file.
-->
<plist version="1.0">
<dict>
	<key>SUPABASE_URL</key>
	<string>https://supabase-ai.dotmini.net</string>
	<key>SUPABASE_ANON_KEY</key>
	<string>YOUR_SELF_HOSTED_SUPABASE_ANON_KEY</string>
	<key>SUPABASE_AUTH_REDIRECT_URL</key>
	<string>microcode://auth/callback</string>
</dict>
</plist>
