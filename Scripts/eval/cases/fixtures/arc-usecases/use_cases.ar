// Standalone Arc examples: statistics, order validation, and task tracking.
// Uses deterministic sample data; no network or filesystem side effects.

struct Summary { count: int, minimum: float, maximum: float, average: float }

fn summarize(values: [float]) -> !Summary {
    if values.is_empty() { return err("cannot summarize an empty dataset") }
    return Summary {
        count: values.len(),
        minimum: values.min().unwrap(),
        maximum: values.max().unwrap(),
        average: values.sum() / float(values.len()),
    }
}

struct OrderLine { product: str, quantity: int, unit_price: float }

fn order_total(lines: [OrderLine]) -> !float {
    if lines.is_empty() { return err("order must contain at least one item") }
    let mut total = 0.0
    for line in lines {
        if line.product.is_empty() { return err("product name must not be empty") }
        if line.quantity <= 0 { return err(f"invalid quantity for {line.product}") }
        if line.unit_price < 0 { return err(f"invalid price for {line.product}") }
        total += float(line.quantity) * line.unit_price
    }
    return total
}

enum TaskState { Pending, Running, Done }
struct Task { title: str, state: TaskState }

fn state_name(state: TaskState) -> str {
    return match state {
        TaskState::Pending => "pending",
        TaskState::Running => "running",
        TaskState::Done => "done",
    }
}

fn advance_task(task: Task) -> !Task {
    return match task.state {
        TaskState::Pending => ok(Task { title: task.title, state: TaskState::Running }),
        TaskState::Running => ok(Task { title: task.title, state: TaskState::Done }),
        TaskState::Done => err(f"task '{task.title}' is already complete"),
    }
}

fn main() {
    println("Use case 1: summarize sensor readings")
    match summarize([21.5, 23.0, 19.5, 24.0]) {
        ok(s) => println(f"count={s.count}, min={s.minimum}, max={s.maximum}, average={s.average}"),
        err(e) => println(f"error: {e}"),
    }
    match summarize([]) {
        ok(_) => println("unexpected success for empty readings"),
        err(e) => println(f"empty dataset rejected: {e}"),
    }

    println("Use case 2: validate and total an order")
    let lines = [
        OrderLine { product: "Notebook", quantity: 3, unit_price: 45.0 },
        OrderLine { product: "Pen", quantity: 2, unit_price: 12.5 },
    ]
    match order_total(lines) {
        ok(total) => println(f"order total: {total}"),
        err(e) => println(f"error: {e}"),
    }
    let invalid = [OrderLine { product: "Pen", quantity: 0, unit_price: 12.5 }]
    match order_total(invalid) {
        ok(_) => println("unexpected success for invalid order"),
        err(e) => println(f"invalid order rejected: {e}"),
    }

    println("Use case 3: task state transitions")
    let mut task = Task { title: "Prepare report", state: TaskState::Pending }
    println(f"{task.title}: {state_name(task.state)}")
    for attempt in [1, 2, 3] {
        match advance_task(task) {
            ok(next) => {
                task = next
                println(f"transition {attempt}: {state_name(task.state)}")
            }
            err(e) => println(f"transition {attempt} rejected: {e}"),
        }
    }
}
